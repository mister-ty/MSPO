# Plantilla de variables de entorno del módulo MSPO.
# Copiar a `.env` y rellenar. NO versionar el `.env` resultante.
#
# En Vercel estas mismas variables se configuran en
# Project Settings -> Environment Variables (Production y Preview).

# --- Conexión a PostgreSQL ----------------------------------------------
# Local:  localhost
# Azure:  <nombre-servidor>.postgres.database.azure.com
PGHOST=
PGPORT=5432
# Ojo: la base en Azure se llama `mspo`. El script mpo.sql (nombre del archivo)
# no impone el nombre de la base; se toma de esta variable.
PGDATABASE=mspo
PGUSER=
PGPASSWORD=

# --- TLS ----------------------------------------------------------------
# `require`  fuerza TLS (obligatorio en Azure Database for PostgreSQL).
# `disable`  lo desactiva (típico en un PostgreSQL local de desarrollo).
# Si se omite, se deduce del host: disable para localhost, require para el resto.
PGSSLMODE=

# --- Tamaño del pool de conexiones --------------------------------------
# En serverless (Vercel) cada instancia mantiene su propio pool y el tier
# Burstable B1ms de Azure sólo admite 35 conexiones de usuario, sin acceso
# a PgBouncer. Dejar en 1 en producción.
# En local se puede subir (p. ej. 10) para el flujo masivo.
PGPOOL_MAX=1
