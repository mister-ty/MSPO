# --- Secretos -----------------------------------------------------------
# Nunca versionar credenciales. Usar .env.example como plantilla.
.env
.env.*
!.env.example

# --- Datos fuente SIRO --------------------------------------------------
# Los exports del SIRO contienen datos personales (NOMBRE CIUDADANO,
# DIRECCION) que el esquema ni siquiera persiste. No entran al repositorio.
*.xlsx
*.xls
*.csv

# --- Dependencias y artefactos de build ---------------------------------
node_modules/
.next/
out/
build/
*.tsbuildinfo

# --- Vercel -------------------------------------------------------------
.vercel

# --- Sistema operativo / editor -----------------------------------------
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# --- Logs ---------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
